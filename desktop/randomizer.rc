#include <windows.h>

1 ICON "randomizer.ico"

/* Per-monitor DPI plus the modern common controls, so the window is not
 * bitmap-stretched on a scaled display. */
1 RT_MANIFEST "randomizer.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "PrefLopLab"
            VALUE "FileDescription",  "PrefLopLab Randomizer"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "randomizer"
            VALUE "OriginalFilename", "PrefLopLab-Randomizer.exe"
            VALUE "ProductName",      "PrefLopLab Randomizer"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
